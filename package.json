{
  "name": "fyrama",
  "version": "1.0.0",
  "private": true,
  "description": "Fyrama — Plataforma inmobiliaria profesional con asesoría jurídica",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "@vercel/blob": "^2.8.2",
    "bcryptjs": "^3.0.2",
